{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThermalIQ",
  "version": "1.0.0",
  "identifier": "com.thermaliq.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ThermalIQ",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "notification": null,
    "updater": {
      "active": true,
      "pubkey": "dW1sVHEzV21SM1o5RjJyVzBXUENXczJqL3pFRjRxaE5kOFVUaEN2L0RGQkk9",
      "endpoints": [
        "https://github.com/lulacoding/thermaliq/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey_format": "base64"
    }
  }
}
