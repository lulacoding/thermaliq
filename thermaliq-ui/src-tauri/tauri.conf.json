{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThermalIQ",
  "version": "1.0.0",
  "identifier": "com.thermaliq.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ThermalIQ",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://127.0.0.1:7272 http://127.0.0.1:7272 https://github.com https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://openrouter.ai; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com"
    },
    "macOS": {
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "Entitlements.plist",
      "exceptionDomain": null,
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "infoPlist": "Info.plist",
      "dmg": {
        "background": null
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "$TAURI_SIGNING_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/lulacoding/thermaliq/releases/latest/download/latest.json"
      ]
    }
  }
}
