{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThermalIQ",
  "version": "1.0.0",
  "identifier": "com.thermaliq.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ThermalIQ",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com"
    },
    "macOS": {
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null,
      "exceptionDomain": null,
      "minimumSystemVersion": null,
      "frameworks": [],
      "dmg": {
        "background": null,
        "windowX": 180,
        "windowY": 100,
        "windowWidth": 600,
        "windowHeight": 400,
        "iconSize": 80,
        "iconX": 180,
        "iconY": 170,
        "appsX": 480,
        "appsY": 170
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "notification": null,
    "updater": {
      "active": true,
      "pubkey": "dW1sVHEzV21SM1o5RjJyVzBXUENXczJqL3pFRjRxaE5kOFVUaEN2L0RGQkk9",
      "endpoints": [
        "https://github.com/lulacoding/thermaliq/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey_format": "base64"
    }
  }
}
