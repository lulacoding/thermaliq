<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>lhm-bridge</AssemblyName>
    <RootNamespace>LhmBridge</RootNamespace>
    <!-- SPEC 5.1: trimming could strip the private LHM fields the restore depends on. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPEC 5.1 exact pin. pre742 is LHM dc51e75, the NCT6687D restore fix. A change here must also
         change LhmInternals.PinnedVersion and pass the hardware checks in README.md. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="[0.9.7-pre742]" />
  </ItemGroup>

</Project>
