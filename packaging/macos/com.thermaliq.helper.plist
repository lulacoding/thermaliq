<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    CANONICAL SOURCE: thermaliq-ui/src-tauri/com.thermaliq.helper.plist
    This file is a trimmed copy kept here for packaging scripts that need
    a standalone plist without the Tauri source tree.  If you update the
    launchd configuration, update the canonical file first and then mirror
    the relevant keys here.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thermaliq.helper</string>

    <key>Program</key>
    <string>/Library/PrivilegedHelperTools/com.thermaliq.helper</string>

    <key>MachServices</key>
    <dict>
        <key>com.thermaliq.helper</key>
        <true/>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/thermaliq-helper.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/thermaliq-helper.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>64</integer>
    </dict>
</dict>
</plist>
